# ============================================
# Telegram Parking Bot - Environment Variables
# ============================================

# Telegram Bot Configuration
# 從 @BotFather 取得 Bot Token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Supabase Configuration
# 從 Supabase Dashboard > Project Settings > API 取得
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Encryption Key
# 用於加密使用者的 TDX API 金鑰
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_random_32_byte_hex_string_here

# Application Configuration
NODE_ENV=development
PORT=3000

# Optional: Monitoring Job Configuration
# 如果使用外部 cron 服務觸發監控任務
MONITORING_JOB_TOKEN=your_monitoring_job_token
MONITORING_JOB_ENDPOINT=http://localhost:3000/monitoring

# Optional: TDX API Base URL (預設值，通常不需要修改)
TDX_API_BASE_URL=https://tdx.transportdata.tw/api/basic
